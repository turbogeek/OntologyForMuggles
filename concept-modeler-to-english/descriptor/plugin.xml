<?xml version="1.0" encoding="UTF-8"?>
<!-- Concept Modeler to English — adds a "Verbalize to English…" action to the Containment-tree
     right-click menu for Concept Modeler packages.

     CLASSLOADER WIRING (important): this plugin calls the Cameo Concept Modeler's API
     (com.nomagic.conceptmodeler.transform.CM2OWL), whose classes live in CCM's own LocalFirst
     classloader. A MagicDraw plugin does NOT see another plugin's classes unless it declares the
     dependency, so we (a) take our own LocalFirst classloader and (b) declare a <required-plugin> on
     the Concept Modeler. Note the id is the Concept Modeler's PLUGIN id — the string "Cameo Concept
     Modeler" (its descriptor's id attribute) — NOT its install directory name com.nomagic.conceptmodeler.
     This wires CCM's exported classes into our classloader so the typed CM2OWL call resolves at runtime. -->
<plugin id="@pluginId@"
        name="Concept Modeler to English"
        version="@pluginVersion@"
        provider-name="OntologyVision"
        class="com.ontologyvision.cm2english.ConceptToEnglishPlugin"
        ownClassloader="true"
        class-lookup="LocalFirst">
    <requires>
        <api version="1.0"/>
        <required-plugin id="Cameo Concept Modeler" name="Cameo Concept Modeler" version="2026x"/>
    </requires>
    <runtime>
        <!-- Only this plugin's own jar is a MagicDraw <library>. The bundled verbalizer
             (lib/ontology-to-english-*-cli.jar) is intentionally NOT listed here: it is loaded at
             runtime in an isolated (parent=null) classloader so its owlapi 5.5.1 never collides with
             MagicDraw's or the Concept Modeler's owlapi 5.1.19. -->
        <library name="@pluginId@.jar"/>
    </runtime>
</plugin>
