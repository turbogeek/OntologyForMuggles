(defclass Component "A component is an structure that can have parts and connections. It is an abstraction of a modular component in a system: for example, physical system, funcational system, software, etc. A component is a system or an atomic component. A system may contain other components. Atomic components cannot contain other components. A component has connectors(pors) through which it communicates and it is coupled with the environment"
	(is-a StructuralThing)
	(role abstract)
	(multislot hasPart
;+		(comment "hasPart is transitive")
		(type INSTANCE)
;+		(allowed-classes Component)
		(create-accessor read-write))
	(single-slot isPartOf
		(type INSTANCE)
;+		(allowed-classes CompositeComponent)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass AtomicComponent "An atomic component may not contain other components"
	(is-a Component)
	(role abstract)
	(multislot hasPart
;+		(comment "hasPart is transitive")
		(type INSTANCE)
;+		(allowed-classes Connector)
		(create-accessor read-write)))

(defclass CompositeComponent
	(is-a Component)
	(role abstract))

(defclass TopologicalThing
	(is-a USER)
	(role abstract))

(defclass TopologicalIndividual
	(is-a TopologicalThing)
	(role abstract)
	(multislot hasConnector
		(type INSTANCE)
;+		(allowed-classes Connector)
		(create-accessor read-write))
	(multislot hasConnection
		(type INSTANCE)
;+		(allowed-classes Connection)
		(create-accessor read-write)))

(defclass EngineeringComponent
	(is-a Component TopologicalIndividual)
	(role concrete))

(defclass System "A system may contain other components."
	(is-a CompositeComponent EngineeringComponent)
	(role concrete))

(defclass AtomicPart
	(is-a AtomicComponent EngineeringComponent)
	(role concrete))

