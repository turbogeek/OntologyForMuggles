(defclass Connector "Connectors(ports) are parts of the components through which they communicate wit the outer world. They are used for coupling components with each other. Connectors don't have behaviours. (for example, no equations for descirbing behavior)"
	(is-a TopologicalThing CompositeComponent)
	(role concrete)
	(multislot hasPart
;+		(comment "hasPart is transitive")
		(type INSTANCE)
;+		(allowed-classes Connector)
		(create-accessor read-write))
	(single-slot isConnectorOf
		(type INSTANCE)
;+		(allowed-classes Component)
;+		(cardinality 0 1)
		(create-accessor read-write)))